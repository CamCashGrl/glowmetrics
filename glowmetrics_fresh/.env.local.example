# Copy to .env.local and fill in. NEVER commit the filled-in file.
# Production values live in the Vercel dashboard, not in the repo.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, bypasses RLS — never expose to the browser

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=
STRIPE_PRICE_EARLY_ADOPTER_MONTHLY=
STRIPE_PRICE_EARLY_ADOPTER_ANNUAL=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Admin panel (/admin) ────────────────────────────────────────────────────
# All three are required. If any is missing, /admin/login returns
# 503 "Admin login is not configured on this server."
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=                       # HMAC signing key: openssl rand -hex 32
