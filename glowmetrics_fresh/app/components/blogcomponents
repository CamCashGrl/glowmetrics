// app/components/BlogComponents.js
// Shared components for all blog posts
// Usage: import { BlogNav, BlogFooter, ArticleSchema, RelatedLinks } from '../../components/BlogComponents'

'use client'

// ── ARTICLE SCHEMA ────────────────────────────────────────────────────────────
// Add <ArticleSchema /> near the top of each blog post article
// Pass in the post's title, description, url, and datePublished
export function ArticleSchema({ title, description, url, datePublished = '2026-01-01' }) {
  const schema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: description,
    url: url,
    datePublished: datePublished,
    dateModified: new Date().toISOString().split('T')[0],
    author: {
      '@type': 'Organization',
      name: 'CamCash',
      url: 'https://www.camcashgrl.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'CamCash',
      url: 'https://www.camcashgrl.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.camcashgrl.com/og-image.png',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': url,
    },
  }

  return (
    <script
      type="application/ld+json"
      dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }}
    />
  )
}

