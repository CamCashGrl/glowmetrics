{
  "manifest_version": 3,
  "name": "CamCash",
  "version": "3.0.0",
  "description": "Real-time tip tracking, whale alerts, and live coaching for cam models",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://chaturbate.com/*",
    "https://*.chaturbate.com/*",
    "https://bongacams.com/*",
    "https://*.bongacams.com/*",
    "https://myfreecams.com/*",
    "https://*.myfreecams.com/*",
    "https://www.camcashgrl.com/*",
    "https://camcashgrl.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chaturbate.com/*",
        "https://*.chaturbate.com/*",
        "https://bongacams.com/*",
        "https://*.bongacams.com/*",
        "https://myfreecams.com/*",
        "https://*.myfreecams.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CamCash"
  }
}
